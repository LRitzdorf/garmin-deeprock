project.manifest = manifest.xml
project.typecheck = 1

# Some devices have 8- or 16-color screens, which need tweaked color settings
fr45.resourcePath = $(fr45.resourcePath);resources-8color
fr55.resourcePath = $(fr55.resourcePath);resources-8color
garminswim2.resourcePath = $(garminswim2.resourcePath);resources-8color
d2bravo.resourcePath = $(d2bravo.resourcePath);resources-16color
d2bravo_titanium.resourcePath = $(d2bravo_titanium.resourcePath);resources-16color
fenix3.resourcePath = $(fenix3.resourcePath);resources-16color
fenix3_hr.resourcePath = $(fenix3_hr.resourcePath);resources-16color
fr230.resourcePath = $(fr230.resourcePath);resources-16color
fr235.resourcePath = $(fr235.resourcePath);resources-16color
fr630.resourcePath = $(fr630.resourcePath);resources-16color
fr735xt.resourcePath = $(fr735xt.resourcePath);resources-16color

# 240x240 Vivoactive devices use different-sized fonts, and need their own layouts
vivoactive3.resourcePath = $(vivoactive3.resourcePath);resources-vivoactive240
vivoactive3d.resourcePath = $(vivoactive3d.resourcePath);resources-vivoactive240
vivoactive3m.resourcePath = $(vivoactive3m.resourcePath);resources-vivoactive240
vivoactive3mlte.resourcePath = $(vivoactive3mlte.resourcePath);resources-vivoactive240

# The Forerunner 920XT is 16-color and also uses different fonts
fr920xt.resourcePath = $(fr920xt.resourcePath);resources-16color;resources-fr920xt

# Most devices are pretty recent and have enough memory for a bitmap background
base.excludeAnnotations = pre240;bgColor
# But a few are pre-CIQ 2.4.0, and need to use old API calls
# Others have limited memory, and must use a solid color background
d2bravo.excludeAnnotations = post240;bgColor
d2bravo_titanium.excludeAnnotations = post240;bgColor
enduro.excludeAnnotations = pre240;bgBitmap
epix.excludeAnnotations = post240;bgColor
fenix3.excludeAnnotations = post240;bgColor
fenix3_hr.excludeAnnotations = post240;bgColor
fenix5s.excludeAnnotations = pre240;bgBitmap
fr230.excludeAnnotations = post240;bgColor
fr235.excludeAnnotations = post240;bgColor
fr45.excludeAnnotations = post240;bgColor
fr630.excludeAnnotations = post240;bgColor
fr920xt.excludeAnnotations = post240;bgColor
garminswim2.excludeAnnotations = post240;bgColor
vivoactive.excludeAnnotations = post240;bgColor
